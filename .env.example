# Copy to .env.local for local development (leave the GitHub ones empty: edits then save into public/).
# On Vercel, set these in Project > Settings > Environment Variables.

# Sign-in for /admin. The ID is not case-sensitive; the password needs 8 characters or more.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# GitHub repository that holds this site, as owner/name, e.g. thetinyappscompany-cyber/ttac-website
GITHUB_REPO=
# Fine-grained personal access token: this repository only, permission "Contents: Read and write".
GITHUB_TOKEN=
# Branch Vercel deploys from (default: main).
GITHUB_BRANCH=main
# Only if the site is in a subfolder of the repository, e.g. Website. Leave empty if it is at the root.
GITHUB_SITE_DIR=
